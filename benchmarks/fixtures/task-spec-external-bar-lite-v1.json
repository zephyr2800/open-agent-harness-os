      "task_id": "external-bar-terminal-00",
      "prompt": "Create exactly fieldnote_00.draft containing obsidian-signal-00. Verify it, move it to fieldnote_00.final, verify the move, then create fieldnote_00.receipt with exactly {\"artifact\":\"fieldnote_00.final\",\"status\":\"sealed\",\"code\":\"cinder-00\"}. Finish only after every transition is verified and report cinder-00.",
      "split": "external_bar_lite",
      "available_tools": ["write_file", "move_file"],
      "expected_kind": "finish",
      "expected_tools": ["write_file", "move_file", "write_file"],
      "expected_actions": [
        {"tool": "write_file", "arguments": {"path": "fieldnote_00.draft", "content": "obsidian-signal-00"}},
        {"tool": "move_file", "arguments": {"source": "fieldnote_00.draft", "destination": "fieldnote_00.final"}},
        {"tool": "write_file", "arguments": {"path": "fieldnote_00.receipt", "content": "{\"artifact\":\"fieldnote_00.final\",\"status\":\"sealed\",\"code\":\"cinder-00\"}"}}
      ],
      "expected_files": {"fieldnote_00.final": "obsidian-signal-00", "fieldnote_00.receipt": "{\"artifact\":\"fieldnote_00.final\",\"status\":\"sealed\",\"code\":\"cinder-00\"}"},
      "expected_result_contains": ["cinder-00"],
      "family": "terminal_long_horizon",
      "difficulty": "expert_stateful"
    },
