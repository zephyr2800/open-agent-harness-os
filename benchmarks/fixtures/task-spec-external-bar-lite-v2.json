      "available_tools": [
        "read_file",
        "write_file"
      ],
      "expected_kind": "finish",
      "expected_tools": [
        "read_file",
        "read_file",
        "write_file"
      ],
      "expected_actions": [
        {
          "tool": "read_file",
          "arguments": {
            "path": "ledger_00.left"
          }
        },
        {
          "tool": "read_file",
          "arguments": {
            "path": "ledger_00.right"
          }
        },
        {
          "tool": "write_file",
          "arguments": {
            "path": "ledger_00.receipt",
            "content": "{\"left\":\"left-proof-00\",\"right\":\"right-proof-00\",\"status\":\"joined\"}"
          }
        }
      ],
      "family": "cross_source_verified_join",
      "difficulty": "expert_adversarial",
      "adversarial": true,
      "initial_files": {
        "ledger_00.left": "left-proof-00",
        "ledger_00.right": "right-proof-00"
