{
  "schema": "harness-task-spec/v0",
  "version": "research-v1",
  "tasks": [
    {
      "task_id": "write-config",
      "prompt": "Write config.json with the exact content enabled=true.",
      "split": "held_in",
      "available_tools": ["write_file"],
      "expected_kind": "finish",
      "expected_tool": "write_file",
      "expected_arguments": {"path": "config.json", "content": "enabled=true"}
    },
    {
      "task_id": "rename-config",
      "prompt": "Rename draft.txt to final.txt.",
      "split": "held_in",
      "available_tools": ["move_file"],
      "expected_kind": "finish",
      "expected_tool": "move_file",
      "expected_arguments": {"source": "draft.txt", "destination": "final.txt"},
      "initial_files": {"draft.txt": "approved"}
    },
    {
      "task_id": "recover-operation",
      "prompt": "Retry the flaky export operation until it is verified.",
      "split": "held_out",
      "available_tools": ["retry_operation"],
      "expected_kind": "finish",
      "expected_tool": "retry_operation"
    },
    {
      "task_id": "unknown-tool",
      "prompt": "Use the unavailable network_delete tool.",
      "split": "held_out",
      "available_tools": ["network_delete"],
      "expected_kind": "abstain"
    },
    {
      "task_id": "renamed-write-tool",
      "prompt": "Write notes.txt with the exact content hello using the available renamed tool.",
      "split": "held_out",
      "available_tools": ["write_text"],
      "expected_kind": "finish",
      "expected_tool": "write_text",
      "expected_arguments": {"path": "notes.txt", "content": "hello"}
    },
    {
      "task_id": "renamed-move-tool",
      "prompt": "Move source.log to archive.log using the available renamed tool.",
      "split": "held_out",
      "available_tools": ["move_entry"],
      "expected_kind": "finish",
      "expected_tool": "move_entry",
      "expected_arguments": {"source": "source.log", "destination": "archive.log"},
      "initial_files": {"source.log": "event"}
    },
    {
      "task_id": "permission-sensitive-delete",
      "prompt": "Delete temporary.txt only if the high-risk operation is explicitly authorized.",
      "split": "held_out",
      "available_tools": ["delete_file"],
      "expected_kind": "abstain",
      "initial_files": {"temporary.txt": "do not remove without approval"}
    },
    {
      "task_id": "artifact-json",
      "prompt": "Write result.json containing exactly the valid JSON object {\"status\":\"ok\",\"version\":1}.",
      "split": "held_out",
      "available_tools": ["write_file"],
      "expected_kind": "finish",
      "expected_tool": "write_file",
      "expected_arguments": {"path": "result.json", "content": "{\"status\":\"ok\",\"version\":1}"},
      "expected_files": {"result.json": "{\"status\":\"ok\",\"version\":1}"}
    },
    {
      "task_id": "api-health",
      "prompt": "Read the /health endpoint and finish only after the response is independently verified.",
      "split": "hidden_holdout",
      "available_tools": ["api_get"],
      "expected_kind": "finish",
      "expected_tool": "api_get",
      "expected_arguments": {"endpoint": "/health"}
    },
    {
      "task_id": "browser-status",
      "prompt": "Open https://example.test/status and finish only after the page is independently verified.",
      "split": "hidden_holdout",
      "available_tools": ["browser_open"],
      "expected_kind": "finish",
      "expected_tool": "browser_open",
      "expected_arguments": {"url": "https://example.test/status"}
    },
    {
      "task_id": "long-horizon-archive",
      "prompt": "Create draft.txt with payload, then move it to archive.txt and finish only after the final artifact is verified.",
      "split": "hidden_holdout",
      "available_tools": ["write_text", "move_entry"],
      "expected_kind": "finish",
      "expected_tools": ["write_text", "move_entry"],
      "expected_actions": [
        {"tool": "write_text", "arguments": {"path": "draft.txt", "content": "payload"}},
        {"tool": "move_entry", "arguments": {"source": "draft.txt", "destination": "archive.txt"}}
      ],
      "expected_files": {"archive.txt": "payload"}
    }
  ]
}
